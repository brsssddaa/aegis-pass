{
  "name": "aegis-pass",
  "version": "1.0.0",
  "description": "Aegis Pass - Bespoke Zero-Knowledge Cyber Security Password Vault",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "password-manager",
    "cybersecurity",
    "zero-knowledge",
    "aes-256",
    "aegis"
  ],
  "author": "Matvey",
  "license": "MIT",
  "build": {
    "appId": "com.aegis.pass",
    "productName": "Aegis Pass",
    "copyright": "Copyright © 2026 Aegis Cyber Security",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aegis Pass"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "server/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8"
  }
}
